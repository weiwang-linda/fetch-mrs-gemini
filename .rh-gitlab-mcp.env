# GitLab MCP Server Configuration
# Edit these values for your GitLab instance

# Required: GitLab personal access token
MCP_GITLAB_TOKEN=<your-personal-gitlab-token>

# Required: Comma-separated list of allowed group and project IDs (numeric IDs only)
# IMPORTANT: Use numeric IDs only (not names or paths) for reliable access
#
# How to find IDs:
#   - Project ID: Visit project in GitLab -> ID shown below project name
#   - Group ID: Visit group in GitLab -> ID in settings or URL
#
# Examples:
#   Specific project IDs: MCP_ALLOWED_REPOS=12345,67890,98765
#   Specific group IDs: MCP_ALLOWED_REPOS=52843642,53727688
#   Mixed (recommended): MCP_ALLOWED_REPOS=12345,52843642,67890,53727688
MCP_ALLOWED_REPOS=<id>

# Optional: Custom GitLab URL (defaults to gitlab.com)
GITLAB_URL=https://gitlab.cee.redhat.com

# Optional: SSL Certificate Configuration (for Red Hat/any corporate internal systems)
# If accessing internal systems (gitlab.cee.redhat.com, etc.),
# specify the path to your SSL CA certificate bundle on the host machine.
# Leave commented out if only accessing public repos.

# Special Note for macOS users: if the cert is in /opt/homebrew it may not work & you can just copy it to your home dir /Users/<your-username>/.certs/<my-cert>.pem
# Uncomment and set the host path to your CA bundle:
# SSL_CERT_PATH=

# These variables tell Python where to find certs INSIDE the container:
# (Only uncomment if SSL_CERT_PATH is set)
#REQUESTS_CA_BUNDLE=
#SSL_CERT_FILE=

# Optional: API rate limiting
MCP_MAX_API_CALLS=1000

# Optional: Allowed actions (comma-separated)
#MCP_ALLOWED_ACTIONS=read,search,list,check
